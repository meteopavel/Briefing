# Backup (тот же сервер что у метеопавела)
ARCHIVE_PASSWORD=
SECURE_RSYNC_USER=
SECURE_RSYNC_HOST=
SECURE_RSYNC_PATH=

# Deploy (Home Router)
DEPLOY_USER=
DEPLOY_HOST=192.168.1.X
DEPLOY_PORT=22
DEPLOY_APP_DIR=/home/YOUR_USER/apps/briefing
DEPLOY_SERVICE=briefing
DEPLOY_BRANCH=main

# Redmine
REDMINE_URL=
REDMINE_API_KEY=
REDMINE_USER_ID=

# Documents
DOCUMENT_OWNER=

# MySQL (БД "briefing" в контейнере edu_mysql на домашнем роутере)
MYSQL_HOST=192.168.1.X
MYSQL_PORT=3306
MYSQL_USER=briefing_app
MYSQL_PASSWORD=
MYSQL_DATABASE=briefing

# MCP-сервер (/mcp) — доступ к тудушкам для Claude Code/zcode
MCP_TOKEN=

# Max-бот: пинги крит-багов mailganer (feat.30). Тот же бот, что в
# django_edu_multisite и Gym_helper; на локальной мак-машине токен можно
# не задавать — клиент читает его из ../Django_EDU_Multisite/.env
MAX_BOT_TOKEN=
MAX_USER_ID=218552779
REDMINE_CRITICAL_PRIORITY_IDS=5
MAX_PING_POLL_SEC=120
